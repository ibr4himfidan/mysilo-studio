# Local default. Production uses a persistent directory outside releases.
MYSILO_DATABASE_PATH=data/mysilo.sqlite
MYSILO_BACKUP_DIR=data/backups
# Enable only behind our loopback-only server and trusted reverse proxy.
MYSILO_TRUST_PROXY=0
# Production only: fixed public HTTPS origin used for CSRF and Secure cookies.
# MYSILO_PUBLIC_ORIGIN=https://your-host.example
