[Unit]
Description=Consistent Mysilo SQLite backup
After=mysilo.service

[Service]
Type=oneshot
User=mysilo
Group=mysilo
WorkingDirectory=/opt/mysilo/current
EnvironmentFile=/etc/mysilo/app.env
ExecStart=/usr/local/bin/node scripts/database.mjs backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mysilo /var/backups/mysilo
