[Unit]
Description=Mysilo Studio production server
After=network.target

[Service]
Type=simple
User=mysilo
Group=mysilo
WorkingDirectory=/opt/mysilo/current
EnvironmentFile=/etc/mysilo/app.env
ExecStart=/usr/local/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mysilo /opt/mysilo/releases

[Install]
WantedBy=multi-user.target
