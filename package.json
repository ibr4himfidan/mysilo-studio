{
  "name": "mysilo-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "install:ci": "npm ci",
    "dev": "next dev --hostname 127.0.0.1 --port 5188",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 5188",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test": "tsx --test tests/*.test.ts",
    "db:init": "node scripts/database.mjs init",
    "db:backup": "node scripts/database.mjs backup",
    "db:import": "node scripts/database.mjs import",
    "build:release": "npm run build && node scripts/package-release.mjs",
    "test:release": "node scripts/smoke-release.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
